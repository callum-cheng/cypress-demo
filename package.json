{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "save-dev": "^0.0.1-security",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cypress:open": "cypress open",
    "cypress-ci": "cypress run --browser chrome && npm run merge-mocha-json-reports-ci && npm run generate-html-report",
    "cypress-ci:win": "cypress run --browser chrome && npm run merge-mocha-json-reports-ci:win && npm run generate-html-report",
    "merge-mocha-json-reports-ci": "npx mochawesome-merge 'reports/functional/.jsons/*.json' > reports/functional/mochawesome.json && rm -r reports/functional/.jsons",
    "merge-mocha-json-reports-ci:win": "npx mochawesome-merge 'reports/functional/.jsons/*.json' > reports/functional/mochawesome.json && rmdir /s /q reports\\functional\\.jsons",
    "generate-html-report": "cd reports/functional && npx marge mochawesome.json",
    "cypress:slow": "cypress run --env commandDelay=500"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/cypress": "^0.1.6",
    "cypress": "^13.14.2",
    "cypress-multi-reporters": "^1.6.4",
    "cypress-slow-down": "^1.3.1",
    "eslint-plugin-cypress": "^3.5.0",
    "jrm": "^1.0.1",
    "wait-on": "^8.0.3"
  }
}
